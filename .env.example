# Required on Vercel: server-only Upstash Redis REST endpoint and token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Compatibility aliases accepted instead of the UPSTASH_ pair.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Canonical public HTTPS origin; used for scheduled timeout callbacks.
APP_BASE_URL=

# Required for scheduled timeout enforcement. Configure in Upstash QStash.
QSTASH_TOKEN=

# Optional QStash API origin; defaults to https://qstash.upstash.io.
# QSTASH_URL=https://qstash.upstash.io

# Long random secret protecting /api/internal/timeout-check.
# Set this yourself; the example contains no usable credentials.
TIMEOUT_SECRET=

# Optional inactivity expiry in hours; defaults to 24.
# ROOM_EXPIRY_HOURS=24

# Optional path for the local development store. Never used on Vercel.
# ROOM_STORE_FILE=

# Local automated tests only. Never set these for a public deployment.
# E2E_TEST_MODE=1
# E2E_TEST_SECRET=
